# Copy to .env. Keep .env private; do not commit it.
APP_PASSWORD=replace-with-your-own-long-family-password
APP_HOST=roadtrip.home.arpa

# Plex runs on the Ubuntu Docker host. Use its LAN address if necessary.
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=replace-with-your-plex-token
# Optional comma-separated MOVIE library section IDs; blank includes all movie libraries.
PLEX_SECTION_IDS=

# Existing absolute folder ON THE DOCKER HOST: local storage or mounted NFS/SMB share.
# Example local path: /srv/movies. Do not use a NAS-internal path or smb:// URL.
MEDIA_SOURCE=/mnt/truenas/movies

# "plex" is the prefix Plex reports for its movie files.
# "local" is the matching path INSIDE the Roadtrip container.
# Create the sentinel once in each actual source folder, including local storage.
# For a network share or separate disk, verify its mount before creating the marker.
MEDIA_PATH_MAPPINGS='[{"plex":"/mnt/truenas/movies","local":"/media/movies","sentinel":".roadtrip-media-root"}]'
